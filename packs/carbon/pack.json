{
  "id": "carbon",
  "name": "Carbon-style",
  "basedOn": "IBM Carbon",
  "license": "Apache-2.0",
  "kind": "open-source",
  "attribution": "https://carbondesignsystem.com",
  "tokens": {
    "font": {
      "sans": "'IBM Plex Sans', 'Helvetica Neue', Arial, sans-serif",
      "mono": "'IBM Plex Mono', ui-monospace, monospace",
      "scale": [12, 14, 16, 20, 28, 36, 54],
      "weight": { "normal": 400, "medium": 500, "semibold": 600 },
      "lineHeight": { "tight": 1.25, "normal": 1.5 }
    },
    "color": {
      "roles": {
        "canvas": "#ffffff",
        "canvasSubtle": "#f4f4f4",
        "fg": "#161616",
        "muted": "#525252",
        "accent": "#0f62fe",
        "accentFg": "#ffffff",
        "success": "#24a148",
        "danger": "#da1e28",
        "border": "#e0e0e0"
      }
    },
    "space": [2, 4, 8, 12, 16, 24, 32, 48],
    "radius": { "sm": 0, "md": 0, "lg": 4, "full": 9999 },
    "shadow": {
      "sm": "0 1px 2px rgba(0,0,0,0.1)",
      "md": "0 2px 6px rgba(0,0,0,0.2)",
      "lg": "0 4px 12px rgba(0,0,0,0.24)"
    },
    "motion": { "fast": "70ms", "normal": "110ms", "easing": "cubic-bezier(0.2, 0, 0.38, 0.9)" }
  },
  "rules": {
    "killGradientText": true,
    "killGlowOnDark": true,
    "maxAccentHues": 1,
    "preferSystemFont": false,
    "flattenOverRoundedCorners": true,
    "demoteEmojiHeadings": true
  }
}
