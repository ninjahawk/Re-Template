{
  "id": "material",
  "name": "Material-style",
  "basedOn": "Google Material",
  "license": "Apache-2.0",
  "kind": "open-source",
  "attribution": "https://m3.material.io",
  "tokens": {
    "font": {
      "sans": "'Roboto', 'Helvetica Neue', Arial, sans-serif",
      "mono": "'Roboto Mono', ui-monospace, monospace",
      "scale": [12, 14, 16, 22, 28, 36, 45],
      "weight": { "normal": 400, "medium": 500, "bold": 700 },
      "lineHeight": { "tight": 1.2, "normal": 1.5 }
    },
    "color": {
      "roles": {
        "canvas": "#ffffff",
        "canvasSubtle": "#f7f2fa",
        "fg": "#1d1b20",
        "muted": "#49454f",
        "accent": "#6750a4",
        "accentFg": "#ffffff",
        "success": "#146c2e",
        "danger": "#b3261e",
        "border": "#cac4d0"
      }
    },
    "space": [4, 8, 12, 16, 24, 32, 48, 64],
    "radius": { "sm": 8, "md": 12, "lg": 16, "full": 9999 },
    "shadow": {
      "sm": "0 1px 2px rgba(0,0,0,0.3)",
      "md": "0 1px 3px 1px rgba(0,0,0,0.15)",
      "lg": "0 4px 8px 3px rgba(0,0,0,0.15)"
    },
    "motion": { "fast": "100ms", "normal": "200ms", "easing": "cubic-bezier(0.2, 0, 0, 1)" }
  },
  "rules": {
    "killGradientText": true,
    "killGlowOnDark": true,
    "maxAccentHues": 1,
    "preferSystemFont": false,
    "flattenOverRoundedCorners": true,
    "demoteEmojiHeadings": true
  }
}
