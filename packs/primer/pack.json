{
  "id": "primer",
  "name": "Primer-style",
  "basedOn": "GitHub Primer",
  "license": "MIT",
  "kind": "open-source",
  "attribution": "https://primer.style",
  "tokens": {
    "font": {
      "sans": "-apple-system, BlinkMacSystemFont, 'Segoe UI', 'Noto Sans', Helvetica, Arial, sans-serif",
      "mono": "ui-monospace, SFMono-Regular, 'SF Mono', Menlo, Consolas, monospace",
      "scale": [12, 14, 16, 20, 24, 32, 40],
      "weight": { "normal": 400, "medium": 500, "semibold": 600 },
      "lineHeight": { "tight": 1.25, "normal": 1.5 }
    },
    "color": {
      "roles": {
        "canvas": "#ffffff",
        "canvasSubtle": "#f6f8fa",
        "fg": "#1f2328",
        "muted": "#59636e",
        "accent": "#0969da",
        "accentFg": "#ffffff",
        "success": "#1a7f37",
        "danger": "#cf222e",
        "border": "#d1d9e0"
      }
    },
    "space": [4, 8, 12, 16, 24, 32, 48, 64],
    "radius": { "sm": 6, "md": 8, "lg": 12, "full": 9999 },
    "shadow": {
      "sm": "0 1px 0 rgba(31,35,40,0.04)",
      "md": "0 3px 6px rgba(31,35,40,0.15)",
      "lg": "0 8px 24px rgba(31,35,40,0.2)"
    },
    "motion": { "fast": "80ms", "normal": "160ms", "easing": "cubic-bezier(0.33, 1, 0.68, 1)" }
  },
  "rules": {
    "killGradientText": true,
    "killGlowOnDark": true,
    "maxAccentHues": 1,
    "preferSystemFont": true,
    "flattenOverRoundedCorners": true,
    "demoteEmojiHeadings": true
  }
}
